@baseUrl = http://localhost:3000

### Health check
GET {{baseUrl}}/

### ============================================
### LIBROS
### ============================================

### Listar todos los libros
GET {{baseUrl}}/api/libros

### Listar solo disponibles
GET {{baseUrl}}/api/libros?disponible=true

### Obtener un libro por ID
GET {{baseUrl}}/api/libros/1

### Libro que no existe (debe dar 404)
GET {{baseUrl}}/api/libros/999

### Crear un libro
POST {{baseUrl}}/api/libros
Content-Type: application/json

{
  "titulo": "Rayuela",
  "autor": "Julio Cortázar",
  "precio": 7000,
  "imagen": "https://images.cdn3.buscalibre.com/fit-in/300x300/rayuela.jpg",
  "disponible": true
}

### Actualizar un libro
PUT {{baseUrl}}/api/libros/1
Content-Type: application/json

{
  "titulo": "El principito (Edición Especial)",
  "autor": "Antoine de Saint-Exupéry",
  "precio": 5500,
  "imagen": "https://images.cdn3.buscalibre.com/fit-in/300x300/el-principito.jpg",
  "disponible": true
}

### Actualizar libro que no existe (debe dar 404)
PUT {{baseUrl}}/api/libros/999
Content-Type: application/json

{
  "titulo": "No existe",
  "autor": "Nadie",
  "precio": 100,
  "imagen": "https://example.com/noexiste.jpg",
  "disponible": false
}

### Eliminar un libro
DELETE {{baseUrl}}/api/libros/1

### Eliminar libro que no existe (debe dar 404)
DELETE {{baseUrl}}/api/libros/999

### ============================================
### AUTORES
### ============================================

### Listar todos los autores
GET {{baseUrl}}/api/autores

### Obtener un autor por ID
GET {{baseUrl}}/api/autores/1

### Autor que no existe (debe dar 404)
GET {{baseUrl}}/api/autores/999

### Crear un autor
POST {{baseUrl}}/api/autores
Content-Type: application/json

{
  "nombre": "Jorge Luis Borges",
  "nacionalidad": "Argentina",
  "fechaNacimiento": "1899-08-24"
}

### Actualizar un autor
PUT {{baseUrl}}/api/autores/1
Content-Type: application/json

{
  "nombre": "Gabriel García Márquez (Actualizado)",
  "nacionalidad": "Colombiana",
  "fechaNacimiento": "1927-03-06"
}

### Actualizar autor que no existe (debe dar 404)
PUT {{baseUrl}}/api/autores/999
Content-Type: application/json

{
  "nombre": "No existe",
  "nacionalidad": "Ninguna"
}

### Eliminar un autor
DELETE {{baseUrl}}/api/autores/1

### Eliminar autor que no existe (debe dar 404)
DELETE {{baseUrl}}/api/autores/999